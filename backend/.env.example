# --- Database (Neon free tier) ---
# postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/detailing

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- Embeddings (free local hash embedder unless OPENAI_API_KEY is set) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- LLM completion ---
# Kimi (Moonshot) is the primary provider. Groq is the secondary/fallback, used
# only if Kimi isn't configured or fails.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low

# Groq, free tier, OpenAI-compatible API. Comma-separated: if one key hits its
# rate limit the app rotates to the next.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# --- Vapi ---
VAPI_SECRET=shared-secret-configured-in-vapi-tool-headers

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Branding ---
BRAND_NAME=ShinePro Detailing
